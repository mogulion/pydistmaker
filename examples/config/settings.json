{
  "app": {
    "name": "示例应用",
    "version": "1.0.0",
    "description": "PyDistMaker示例应用程序"
  },
  "processing": {
    "default_encoding": "utf-8",
    "max_file_size": 10485760,
    "supported_formats": ["txt", "json", "csv", "xml"],
    "backup": true,
    "backup_dir": "./backups"
  },
  "logging": {
    "level": "INFO",
    "file": "./logs/app.log",
    "max_size": 1048576,
    "backup_count": 3
  }
}